<Window x:Class="Sayra.UI.Views.MaintenanceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Sayra.UI.Controls"
        mc:Ignorable="d"
        Title="System Maintenance" WindowStyle="None" WindowState="Maximized" Topmost="True"
        Background="#08090D" Height="1080" Width="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dynamic Ad Carousel playing sponsors' advertisements during maintenance -->
        <controls:AdCarousel x:Name="MaintenanceCarousel" Grid.Row="0" Margin="0" />

        <!-- Status & Branding Panel (Yellow/Black theme) -->
        <Border Grid.Row="1" Background="#111216" BorderBrush="#FFCC00" BorderThickness="0,2,0,0" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ایستگاه کاری در حال بروزرسانی و تعمیرات" Foreground="#FFCC00" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI, Tahoma" Margin="0,0,0,5" FlowDirection="RightToLeft" />
                    <TextBlock Text="Workstation is undergoing scheduled maintenance. Please wait." Foreground="#A0A5B5" FontSize="14" FontFamily="Segoe UI" />
                </StackPanel>

                <!-- Brand Emblem -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#FFCC00" Width="4" Height="40" CornerRadius="2" Margin="0,0,15,0" />
                    <StackPanel>
                        <TextBlock Text="SAYRA" Foreground="White" FontSize="20" FontWeight="Black" FontFamily="Segoe UI" />
                        <TextBlock Text="ENTERPRISE KIOSK" Foreground="#FFCC00" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
