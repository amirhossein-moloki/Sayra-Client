{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SayraClient": "Information"
    },
    "File": {
      "Path": "logs/client-.log",
      "RetainedFileCountLimit": 30,
      "RollingInterval": "Day"
    }
  },
  "ServerDiscovery": {
    "Enabled": true,
    "UdpPort": 37020,
    "DiscoveryTimeoutSeconds": 5
  },
  "ServerConfig": {
    "Port": 5000,
    "HeartbeatIntervalSeconds": 10,
    "ReconnectIntervalSeconds": 5,
    "MaxReconnectAttempts": -1
  },
  "SecurityConfig": {
    "MasterKey": "PLACEHOLDER_SET_VIA_ENV_OR_USER_SECRETS"
  },
  "UpdateConfig": {
    "UpdateUrl": "http://SAYRA_SERVER_IP:5000/api/updates/manifest",
    "CheckIntervalMinutes": 60,
    "AutoUpdate": true,
    "VerifySignature": true,
    "PublicKey": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA7V8nZ..."
  },
  "Diagnostics": {
    "PollingIntervalMs": 1000,
    "CacheDurationMinutes": 5,
    "EnableGpuMonitoring": true,
    "EnableNetworkMonitoring": true,
    "EnableStorageMonitoring": true,
    "EnableTemperatureMonitoring": true,
    "LogHardwareChanges": true,
    "ValidationRetryCount": 3
  },
  "Observability": {
    "Telemetry": {
      "EnableTelemetry": true,
      "SamplingRate": 1.0,
      "BufferSize": 1000
    },
    "Metrics": {
      "AggregationWindowSeconds": 60,
      "EnableMovingAverages": true
    },
    "Tracing": {
      "SamplingProbability": 1.0,
      "MaxTraceDepth": 10,
      "RequestTimeoutMilliseconds": 5000
    },
    "Performance": {
      "LatencyWarningThresholdMilliseconds": 1000,
      "MemoryLimitMegabytes": 512
    },
    "Diagnostics": {
      "ThreadDumpIntervalSeconds": 300,
      "MemorySnapshotLimitMegabytes": 1024
    },
    "Alerts": {
      "CpuThresholdPercent": 90.0,
      "MemoryThresholdPercent": 90.0,
      "DiskFreeSpaceThresholdPercent": 10.0,
      "CooldownPeriodSeconds": 300
    },
    "Dashboard": {
      "RefreshIntervalSeconds": 5,
      "MaxVisibleAlerts": 50
    },
    "HistoricalStorage": {
      "DatabasePath": "Data/historical_metrics.db",
      "UseCompression": true,
      "PageSize": 4096
    },
    "Monitoring": {
      "HeartbeatTimeoutSeconds": 30,
      "EnableProcessTamperingCheck": true
    },
    "Retention": {
      "RetentionDays": 30,
      "PolicyType": "Daily"
    },
    "Collection": {
      "CriticalIntervalSeconds": 5,
      "PerformanceIntervalSeconds": 15,
      "HardwareIntervalSeconds": 30,
      "StorageIntervalSeconds": 60,
      "HistoricalIntervalSeconds": 300
    }
  }
}
